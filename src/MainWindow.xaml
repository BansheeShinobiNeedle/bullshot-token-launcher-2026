<Window x:Class="BullshotLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d"
        Title="Bullshot Token Launcher"
        Height="550"
        Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e1e"
        Foreground="#cccccc">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Bullshot Token Launcher"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#007acc"
                   Margin="0,0,0,20"/>

        <TabControl Grid.Row="1" Margin="0,0,0,16">
            <TabItem Header="Curve Tracker">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Token Address:" Width="120" Foreground="#cccccc"/>
                        <TextBox x:Name="txtTokenAddress" Width="300" Margin="0,0,8,0"/>
                        <Button x:Name="btnTrack" Content="Track" Width="100" Height="32"
                                Background="#007acc" Foreground="White" BorderThickness="0" Click="BtnTrack_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="txtCurveResult" Margin="0,16,0,0" Foreground="#cccccc" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Fee Calculator">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Initial Price:" Width="120" Foreground="#cccccc"/>
                        <TextBox x:Name="txtInitialPrice" Width="120" Margin="0,0,8,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Current Price:" Width="120" Foreground="#cccccc"/>
                        <TextBox x:Name="txtCurrentPrice" Width="120" Margin="0,0,8,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Volume:" Width="120" Foreground="#cccccc"/>
                        <TextBox x:Name="txtVolume" Width="120" Margin="0,0,8,0"/>
                    </StackPanel>
                    <Button x:Name="btnCalculateFee" Content="Calculate Fee" Width="160" Height="36"
                            Background="#007acc" Foreground="White" BorderThickness="0" Click="BtnCalculateFee_Click"/>
                    <TextBlock x:Name="txtFeeResult" Margin="0,16,0,0" Foreground="#cccccc" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Quests">
                <StackPanel>
                    <TextBlock Text="Quest List" FontWeight="Bold" Foreground="#007acc" Margin="0,0,0,8"/>
                    <ListBox x:Name="lstQuests" Height="250" Foreground="#cccccc"/>
                    <Button x:Name="btnRefreshQuests" Content="Refresh Quests" Width="140" Height="32"
                            Background="#333333" Foreground="White" BorderThickness="0" Click="BtnRefreshQuests_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Margin="0,20,0,0" Background="#2d2d2d" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Foreground="#888888" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>